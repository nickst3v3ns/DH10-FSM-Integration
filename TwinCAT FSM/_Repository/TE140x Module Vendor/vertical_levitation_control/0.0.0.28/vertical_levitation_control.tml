    <DataType>
      <Name GUID="{B9F02140-CAA9-4E79-6B0C-829BE9E1C97C}" IecLibraryType="true" CName="TcMgSdk::ModuleCaller">E_ModuleCaller</Name>
      <Comment><![CDATA[Generated from type 'TcMgSdk.ModuleCaller']]></Comment>
      <BitSize>32</BitSize>
      <BaseType GUID="{18071995-0000-0000-0000-000000000009}">DINT</BaseType>
      <EnumInfo>
        <Text><![CDATA[CyclicTask]]></Text>
        <Enum>0</Enum>
        <Comment><![CDATA[Add to the specified cyclic caller tasks.]]></Comment>
      </EnumInfo>
      <EnumInfo>
        <Text><![CDATA[Module]]></Text>
        <Enum>1</Enum>
        <Comment><![CDATA[Don't add to cyclic callers. The module can be called from other TwinCAT modules (e. g. a PLC).]]></Comment>
      </EnumInfo>
    </DataType>
    <DataType>
      <Name GUID="{CE25FBCB-2F9C-EEF7-5DD3-2212FDC9DF0E}" IecLibraryType="true" CName="TcMgSdk::CallerVerification">E_CallerVerification</Name>
      <Comment><![CDATA[Generated from type 'TcMgSdk.CallerVerification']]></Comment>
      <BitSize>32</BitSize>
      <BaseType GUID="{18071995-0000-0000-0000-000000000009}">DINT</BaseType>
      <EnumInfo>
        <Text><![CDATA[Default]]></Text>
        <Enum>0</Enum>
        <Comment><![CDATA[Verify the caller task only if the "ModuleCaller" parameter is set to "Module" but not when added to cyclic caller tasks.]]></Comment>
      </EnumInfo>
      <EnumInfo>
        <Text><![CDATA[Always]]></Text>
        <Enum>1</Enum>
        <Comment><![CDATA[Always verify the caller context to prevent concurrent execution of model code and corresponding DataArea mappings.]]></Comment>
      </EnumInfo>
      <EnumInfo>
        <Text><![CDATA[Never]]></Text>
        <Enum>2</Enum>
        <Comment><![CDATA[Skip caller verification to reduce execution times.]]></Comment>
      </EnumInfo>
    </DataType>
    <DataType>
      <Name GUID="{35C6DBC1-CD26-8FFC-ABC2-0FF2BE07977C}" IecLibraryType="true" CName="TcMgSdk::StepSizeAdaptation">E_StepSizeAdaptation</Name>
