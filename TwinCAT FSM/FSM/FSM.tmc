date -> ADS processing ]]></Comment></EnumInfo></DataType><DataType><Name Namespace="ETML_DH10">E_FpExcptCtrlSet</Name><Comment><![CDATA[ Generated from type 'TcMgSdk.FpExcptCtrlSet' ]]></Comment><BitSize>8</BitSize><BaseType>USINT</BaseType><EnumInfo><Text>CallerExceptions</Text><Enum>1</Enum><Comment><![CDATA[ Use the floating point exception settings provided by the caller ]]></Comment></EnumInfo><EnumInfo><Text>ThrowExceptions</Text><Enum>3</Enum><Comment><![CDATA[ Enable floating point exceptions on invalid operations and divisions by zero ]]></Comment></EnumInfo><EnumInfo><Text>SuppressExceptions</Text><Enum>5</Enum><Comment><![CDATA[ Disable floating point exceptions. ]]></Comment></EnumInfo></DataType><DataType><Name Namespace="ETML_DH10">E_FpExcptCtrlSetEx</Name><Comment><![CDATA[ Generated from type 'TcMgSdk.FpExcptCtrlSetEx' ]]></Comment><BitSize>8</BitSize><BaseType>USINT</BaseType><EnumInfo><Text>CallerExceptions</Text><Enum>1</Enum><Comment><![CDATA[ Use the floating point exception settings provided by the caller ]]></Comment></EnumInfo><EnumInfo><Text>ThrowExceptions</Text><Enum>3</Enum><Comment><![CDATA[ Enable floating point exceptions on invalid operations and divisions by zero ]]></Comment></EnumInfo><EnumInfo><Text>SuppressExceptions</Text><Enum>13</Enum><Comment><![CDATA[ Disable floating point exceptions. ]]></Comment></EnumInfo><EnumInfo><Text>LogExceptions</Text><Enum>19</Enum><Comment><![CDATA[ Log exception information. ]]></Comment></EnumInfo><EnumInfo><Text>LogAndHold</Text><Enum>51</Enum><Comment><![CDATA[ Log exception information and puase execution of the cyclic code after completion of the actual cycle ]]></Comment></EnumInfo><EnumInfo><Text>LogAndCatch</Text><Enum>83</Enum><Comment><![CDATA[ Log exception information and immediately terminate execution of the cyclic code. Reinitialization is required to restart. ]]></Comment></EnumInfo><EnumInfo><Text>LogAndDump</Text><Enum>147</Enum><Comment><![CDATA[ Log exception information, cr