//All of the CAN IDs and what they correspond to

TYPE Drive_error_mapping :
(
	Motor_overload := 0,
	Heatsink_overtemp := 1,
	Motor_overtemp := 2,
	Drive_overtemp := 3,
	Control_voltage := 4,
	Feedback := 5,
	Commutation := 6,
	Overcurrent := 7,
	Overvoltage := 8,
	Undervoltage := 9,
	Supply_phase := 10,
	Psn_dev := 11,
	Comms := 12,
	Overtravel := 13,
	none := -1
)INT := none;
END_TYPE
]]></Declaration>
