<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="State_Levi_Ready" Id="{693e504e-414d-40fe-b6e3-202498c8bffc}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK State_Levi_Ready

VAR_INPUT
	drive_status : ARRAY[0..23] OF UINT;
	drive_diagnostics : ARRAY[0..23] OF UINT;
	Force_feedback_value : ARRAY[0..23] OF INT;
	drive_refs : ARRAY[0..23] OF ST_DriveRef;
	PLC_drive_refs : ARRAY[0..23] OF ST_PLCDriveRef;
	State : E_Levi_States;
	Run_z_liftoff_calc : BOOL;
	z: LREAL;
END_VAR

VAR_OUTPUT
	reset_busy : BOOL;
	Levi_ready: BOOL;
	Go_error_state : BOOL;
	z_liftoff: LREAL;
END_VAR

VAR_IN_OUT
	Control_word_array : ARRAY[0..23] OF UINT;
	drive_feedback_timeouts : ARRAY[0..23] OF UINT;
	force_values : ARRAY[0..11] OF INT;
	Drive_current_error : ARRAY[0..23] OF BOOL;
	error_specifics: ARRAY [0..23] OF Drive_error_mapping;
	dancing : BOOL;
	(*
	//Liftoff model
	FB_control_liftoff_init: ST_FB_Liftoff_model_TcCom_InitStruct := (noid:=16#01010050);
	FB_control_liftoff: FB_Liftoff_model_TcCom_InitStruct(FB_control_liftoff_init);
	
	Control_liftoff_inputs: ST_Liftoff_model_U_T;
	Control_liftoff_outputs: ST_Liftoff_model_Y_T;
	Control_liftoff_parameters: ST_P_Liftoff_model_T;
	*)
END_VAR

VAR
	//For errors, this way we can reset all the drives at once
	reset_FBs: ARRAY[0..23] OF FB_SoEExecuteCommand_ByDriveRef;
	reset_command: WORD := S_0_IDN + 99;
	reset_error_timeout: TIME := T#10S;
	Drive_undervoltage : BOOL;
	Error : BOOL;
	reset_error : BOOL;
	n_drive_warnings : UINT;
	n_drive_errors : UINT;	
	
	count_cycles: INT;
	
	i : INT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[(*
normal_shutdown := FALSE;

//-----------------------------------------------------------------------------------------------------------
Control_liftoff_parameters.blevi_operational := FALSE;
Control_descent_parameters.blevi_operational := FALSE;
Control_lat_parameters.blevi_operational := FALSE;
Control_vert_parameters.blevi_operational := FALSE;

Control_liftoff_parameters.benable_auto_z_target := FALSE;
Control_liftoff_parameters.benable_auto_y_target := FALSE;
Control_liftoff_parameters.benable_auto_yaw_target := FALSE;

FB_Control_liftoff.stLiftoff_model_P := Control_liftoff_parameters;		
FB_Control_descent.stDescent_model_P := Control_descent_parameters;		
FB_Control_lat.stlateral_levitation_control_new_P := Control_lat_parameters;
FB_Control_vert.stvertical_levitation_control_new_P := Control_vert_parameters;	

//-----------------------------------------------------------------------------------------------------------
z_target := z_initial_target;
found_auto_z_target := FALSE;
found_auto_y_target := FALSE;
found_auto_yaw_target := FALSE;


Control_liftoff_inputs.fz_target := z_target;
Control_liftoff_inputs.aFeedback_current := Real_currents;

FB_Control_liftoff(stLiftoff_model_U := Control_liftoff_inputs, stLiftoff_model_Y => Control_liftoff_outputs);

z_target := Control_liftoff_outputs.fnew_z_target;

FB_Control_descent(stDescent_model_Y => Control_descent_outputs);

z_target := z_initial_target;

//-------------------------------------------------------------------------------------------------------------

Control_lat_inputs.fy := y_filtered;
Control_lat_inputs.fyaw := yaw_filtered;
Control_lat_inputs.fmotor_Fx_l := 0;
Control_lat_inputs.fmotor_Fx_r := 0;
Control_lat_inputs.fmotor_Fy_l := 0;
Control_lat_inputs.fmotor_Fy_r := 0;

FB_Control_lat(stlateral_levitation_control_new_U := Control_lat_inputs, stlateral_levitation_control_new_Y => Control_lat_outputs);

//-------------------------------------------------------------------------------------------------------------

Control_vert_inputs.fz_avg := z_filtered;
Control_vert_inputs.froll_measured := roll_filtered;
Control_vert_inputs.fpitch_measured := pitch_filtered;
Control_vert_inputs.fems_roll := 0;
Control_vert_inputs.fmotor_Fy_l := 0;
Control_vert_inputs.fmotor_Fy_r := 0;

FB_Control_vert(stvertical_levitation_control_new_U := Control_vert_inputs, stvertical_levitation_control_new_Y => Control_vert_outputs);

//-------------------------------------------------------------------------------------------------------------
*)
dancing := FALSE;
reset_busy := FALSE;
Drive_undervoltage := FALSE;

FOR i:=0 TO 23 DO
	Control_word_array[i] := 16#E000;
END_FOR

//Check if there are errors
Error := Check_drives(drive_status := drive_status, 
					drive_diagnostics := drive_diagnostics, 
					drive_last_request_value := force_values,
					drive_last_feedback_value := Force_feedback_value,
					drive_feedback_timeouts := drive_feedback_timeouts,
					State := State,
					errors := error_specifics,
					Drive_current_error := Drive_current_error,
					n_warns => n_drive_warnings, 
					n_errors => n_drive_errors);

//Try to reset any errors if there are undervoltage errors.
//Those are probably left over from switching on the high voltage and can be reset safely		
FOR i:=0 TO 23 DO
	IF error_specifics[i] = Drive_error_mapping.Undervoltage THEN
		reset_FBs[i](stDriveRef := drive_refs[i], nIdn := reset_command, bExecute := TRUE, tTimeout := reset_error_timeout);
		reset_busy := TRUE;
		Drive_undervoltage := TRUE;
	
		IF NOT reset_FBs[i].bBusy THEN
			reset_FBs[i](stDriveRef := drive_refs[i], nIdn := reset_command, bExecute := FALSE, tTimeout := reset_error_timeout);
			
			//Keep track of any errors
			reset_error := reset_error OR reset_FBs[i].bError;
		END_IF
	END_IF
END_FOR

IF Run_z_liftoff_calc = FALSE THEN
	//Setting the liftoff airgap
	count_cycles := count_cycles + 1;
	
		IF count_cycles > 3000 THEN
			z_liftoff := z;
			count_cycles := 0;
			Run_z_liftoff_calc := TRUE;
		END_IF
END_IF

//Switching on drives but no output
force_values[0] := 0;
force_values[1] := 0;

force_values[2] := 0;
force_values[3] := 0;

force_values[4] := 0;
force_values[5] := 0;

force_values[6] := 0;
force_values[7] := 0;

force_values[8] := 0;
force_values[9] := 0;

force_values[10] := 0;
force_values[11] := 0;



//Tell the main code that we are either ready to start levitating, or that there are other errors which are not undervoltage, and we should go to error state
IF reset_busy = FALSE AND ERROR = FALSE AND reset_error = FALSE THEN
	Levi_ready := TRUE;
ELSIF ERROR AND Drive_undervoltage = FALSE OR reset_error THEN
	Go_error_state := TRUE;
END_IF]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>