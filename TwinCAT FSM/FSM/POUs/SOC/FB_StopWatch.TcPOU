<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_StopWatch" Id="{89bb6a2f-80c7-431c-a40b-3916ef012286}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_StopWatch
VAR_INPUT
	bEnable		:BOOL;
	bReset		:BOOL;
END_VAR
VAR_OUTPUT
	tElapsed	: TIME;
	lrElapsedSeconds : LREAL;
END_VAR
VAR
	fbEdge : R_TRIG;
	tStartTime : TIME;
	tSavedTime : TIME;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// Detect the exact cycle bEnable is turned on
fbEdge(CLK := bEnable);

IF fbEdge.Q THEN
    tStartTime := TIME(); // Capture the system clock at start
END_IF

// Handle Reset
IF bReset THEN
    tSavedTime := T#0S;
    tElapsed   := T#0S;
    tStartTime := TIME(); // Prevents a time jump if reset while running
END_IF

// Calculate Elapsed Time
IF bEnable AND NOT bReset THEN
    // Current time minus start time, plus any previously accumulated time
    tElapsed := (TIME() - tStartTime) + tSavedTime;
ELSIF NOT bEnable THEN
    // Keep saving the last known elapsed time when paused
    tSavedTime := tElapsed; 
END_IF

// Convert the millisecond TIME value to floating-point seconds
lrElapsedSeconds := TIME_TO_LREAL(tElapsed) / 1000.0;]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>