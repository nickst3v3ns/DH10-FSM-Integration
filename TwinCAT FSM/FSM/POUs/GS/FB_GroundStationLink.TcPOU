    <Method Name="FlushBatch" Id="{992beee3-aef5-4593-92eb-1fae988f1a0e}">
      <Declaration><![CDATA[METHOD FlushBatch : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF txBatchLen = 0 OR bSendPending THEN
	FlushBatch := TRUE;
	RETURN;
END_IF

fbSend(
	hSocket := fbConnect.hSocket,
	cbLen := txBatchLen,
	pSrc := ADR(txBatch),
	bExecute := TRUE
);

bSendPending := TRUE;
txBatchLen := 0;
FlushBatch := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnHeartbeat" Id="{d2394bbb-1b1e-4317-a4ac-c5260873b8f4}">
      <Declaration><![CDATA[METHOD OnHeartbeat : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[nHeartbeatsRx := nHeartbeatsRx + 1;

wdGsLink(IN := FALSE);
OnHeartbeat := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="PollReceive" Id="{62925d86-ab69-423e-bb6f-d19498152213}">
      <Declaration><![CDATA[METHOD PollReceive : BOOL
VAR
	bytesAvail : UDINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[fbReceive(
	hSocket  := fbConnect.hSocket,
	pDest    := ADR(rxScratch),
	cbLen    := SIZEOF(rxScratch),
	bExecute := TRUE
);
IF NOT fbReceive.bBusy AND NOT fbReceive.bError THEN
	fbReceive(bExecute := FALSE);
	IF fbReceive.nRecBytes > 0 THEN
		// Append to rxBuffer.
		IF (rxLen + fbReceive.nRecBytes) <= SIZEOF(rxBuffer) THEN
			MEMCPY(ADR(rxBuffer[rxLen]), ADR(rxScratch), fbReceive.nRecBytes);
			rxLen := UDINT_TO_UINT(rxLen + fbReceive.nRecBytes);
			TryParseFrames();
		ELSE
			// Buffer overflow — drop and resync. Treat as protocol error.
			rxLen := 0;
			eState := E_LinkState.eError;
		END_IF
	END_IF
ELSIF fbReceive.bError THEN
	fbReceive(bExecute := FALSE);
	eState := E_LinkState.eError;
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="SendDatapoint" Id="{1954acf1-0f13-4f0b-8601-03ebb95491bf}">
      <Declaration><![CDATA[METHOD SendDatapoint : BOOL
VAR_INPUT
	id : UINT;
	valueBits: ULINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[BuildDatapoint(
	id := id,
	valueBits := valueBits,
	timestampUs := 0,
	dp := dp1);
	
fbSend(
	hSocket := fbConnect.hSocket,
	cbLen := SIZEOF(dp1),
	pSrc := ADR(dp1),
	bExecute := TRUE);

bSendPending := TRUE;
nSeqTx := nSeqTx + 1;
SendDatapoint := TRUE;
	
	]]></ST>
      </Implementation>
    </Method>
    <Method Name="SendFlow" Id="{81541abe-e6ef-4d15-ae44-5c575c029872}">
      <Declaration><![CDATA[METHOD SendFlow : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[nSeqTx := nSeqTx + 1;
telemetry.counter := telemetry.counter + 1;
telemetry.timestamp_us := telemetry.timestamp_us + 10000; // placeholder while looking for method that gives system time

fbEncoder(
    msgId      := 16#0010,
    seqNum     := nSeqTx,
    pPayload   := ADR(telemetry),
    payloadLen := SIZEOF(telemetry)
);

fbSend(
    hSocket  := fbConnect.hSocket,
    cbLen    := fbEncoder.frameLen,
    pSrc     := ADR(fbEncoder.frame),
    bExecute := TRUE
);
bSendPending := TRUE;
SendTelemetry();]]></ST>
      </Implementation>
    </Method>
