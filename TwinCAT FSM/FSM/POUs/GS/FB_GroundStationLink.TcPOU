END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[MEMCPY(ADR(DecodeF64), ADR(bits), 8);]]></ST>
      </Implementation>
    </Method>
    <Method Name="DecodeI16" Id="{754fb116-512f-451f-8a50-e06e92ebd5fd}">
      <Declaration><![CDATA[METHOD DecodeI16 : INT
