    </Method>
    <Method Name="AppendDpU32" Id="{f619bf4f-38d3-47e9-bf28-b2682df9ba52}">
      <Declaration><![CDATA[METHOD AppendDpU32 : BOOL
VAR_INPUT
	id : UINT;
