      </Implementation>
    </Method>
    <Method Name="SendDpU16" Id="{994ce20f-4c6e-4e04-a056-e10db23869a0}">
      <Declaration><![CDATA[METHOD SendDpU16 : BOOL
VAR_INPUT
	id : UINT;
	value : UINT;
END_VAR
VAR
	bits : ULINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[bits := 0;
MEMCPY(ADR(bits), ADR(value), 2);
SendDatapoint(id := id, valueBits := bits);]]></ST>
      </Implementation>
    </Method>
    <Method Name="SendDpU32" Id="{f619bf4f-38d3-47e9-bf28-b2682df9ba52}">
      <Declaration><![CDATA[METHOD SendDpU32 : BOOL
VAR_INPUT
	id : UINT;
