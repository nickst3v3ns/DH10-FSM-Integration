    <Method Name="BuildDatapoint" Id="{1984dfb5-e247-4430-8114-76733fe18619}">
      <Declaration><![CDATA[METHOD PRIVATE BuildDatapoint : BOOL
VAR_INPUT
    id          : UINT;
    valueBits   : ULINT;
    timestampUs : ULINT;
END_VAR
VAR_IN_OUT
    dp : ST_DatapointFrame;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[dp.sentinelStart := 16#FF;
dp.idBE[0]       := UINT_TO_BYTE(SHR(id, 8) AND 16#FF);   // high byte first (BE)
dp.idBE[1]       := UINT_TO_BYTE(id AND 16#FF);           // low byte
dp.value         := valueBits;
dp.timestampUs  := timestampUs;
dp.sentinelEnd   := 16#FF;
BuildDatapoint := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="DecodeF32" Id="{21e93e0a-6b13-4ba7-b284-1e00db11fbfe}">
      <Declaration><![CDATA[METHOD DecodeF32 : REAL
VAR_INPUT
	bits : ULINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[MEMCPY(ADR(DecodeF32), ADR(bits), 4);]]></ST>
      </Implementation>
    </Method>
    <Method Name="DecodeF64" Id="{f6360286-985c-4749-ac46-ecccb7c39792}">
      <Declaration><![CDATA[METHOD DecodeF64 : LREAL
VAR_INPUT
