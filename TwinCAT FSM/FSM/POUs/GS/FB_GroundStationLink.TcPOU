    <Method Name="SendPropulsion" Id="{100d753a-6bef-4543-8ded-1ff745c56ed9}">
      <Declaration><![CDATA[METHOD SendPropulsion : BOOL
VAR_INPUT
	nPropIndex : INT := 0;
	nSendCounter : INT := 0;
	nNumber : INT := 20;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[
CASE nPropIndex OF
    0:  SendDpU8(GVL_GS_PROP_IDS.DP_ID_PROP_FLAG, INT_TO_BYTE(GVL_Prop.PropFlag));
    1:  SendDpF64(GVL_GS_PROP_IDS.DP_ID_PROP_POSITION,            REAL_TO_LREAL(GVL_Prop.position));
    2:  SendDpF64(GVL_GS_PROP_IDS.DP_ID_PROP_POSITION_INTERPOLATED, 0.0);                          // TODO: source var
    3:  SendDpF64(GVL_GS_PROP_IDS.DP_ID_PROP_VELOCITY,            REAL_TO_LREAL(GVL_Prop.Velocity));
    4:  SendDpU16(GVL_GS_PROP_IDS.DP_ID_PROP_FAULT_RIGHT,         0);                              // TODO: source var
    5:  SendDpU16(GVL_GS_PROP_IDS.DP_ID_PROP_FAULT_LEFT,          0);                              // TODO: source var
    6:  SendDpF64(GVL_GS_PROP_IDS.DP_ID_PROP_CURRENT_ANGLE_RIGHT, 0.0);                            // TODO: source var
    7:  SendDpF64(GVL_GS_PROP_IDS.DP_ID_PROP_CURRENT_ANGLE_LEFT,  0.0);                            // TODO: source var
    8:  SendDpI32(GVL_GS_PROP_IDS.DP_ID_PROP_TARGET_VELOCITY,     LREAL_TO_DINT(REAL_TO_LREAL(GVL_Prop.TargetVelocity) * 1000.0));  // m/s → mm/s
    9:  SendDpF64(GVL_GS_PROP_IDS.DP_ID_PROP_VBUS_RIGHT,          REAL_TO_LREAL(GVL_PROP.Vbus_Right));  // verify mapping
    10: SendDpF64(GVL_GS_PROP_IDS.DP_ID_PROP_VBUS_LEFT,           REAL_TO_LREAL(GVL_PROP.Vbus_Left));  // verify mapping
    11: SendDpU16(GVL_GS_PROP_IDS.DP_ID_PROP_STATE_RIGHT,         0);                              // TODO
    12: SendDpU16(GVL_GS_PROP_IDS.DP_ID_PROP_STATE_LEFT,          0);                              // TODO
    13: SendDpF64(GVL_GS_PROP_IDS.DP_ID_PROP_ID_RIGHT,            0.0);                            // TODO: d-axis current
    14: SendDpF64(GVL_GS_PROP_IDS.DP_ID_PROP_IQ_RIGHT,            0.0);                            // TODO: q-axis current
    15: SendDpF64(GVL_GS_PROP_IDS.DP_ID_PROP_IA_RIGHT,            GVL_Prop.Ia_right);
    16: SendDpF64(GVL_GS_PROP_IDS.DP_ID_PROP_IB_RIGHT,            GVL_Prop.Ib_right);
    17: SendDpF64(GVL_GS_PROP_IDS.DP_ID_PROP_IC_RIGHT,            GVL_Prop.Ic_right);
    18: SendDpF64(GVL_GS_PROP_IDS.DP_ID_PROP_ID_LEFT,             0.0);                            // TODO
    19: SendDpF64(GVL_GS_PROP_IDS.DP_ID_PROP_IQ_LEFT,             0.0);                            // TODO
    20: SendDpF64(GVL_GS_PROP_IDS.DP_ID_PROP_IA_LEFT,             GVL_Prop.Ia_left);
    21: SendDpF64(GVL_GS_PROP_IDS.DP_ID_PROP_IB_LEFT,             GVL_Prop.Ib_left);
    22: SendDpF64(GVL_GS_PROP_IDS.DP_ID_PROP_IC_LEFT,             GVL_Prop.Ic_left);
    23: SendDpU8 (GVL_GS_PROP_IDS.DP_ID_PROP_DRIVE_RESET,         0);                              // TODO
    24: SendDpU8 (GVL_GS_PROP_IDS.DP_ID_PROP_AUTO_PILOT_FLAG,     0);                              // TODO
    25: SendDpU16(GVL_GS_PROP_IDS.DP_ID_PROP_TA_GD_LEFT,          0);                              // TODO
    26: SendDpU16(GVL_GS_PROP_IDS.DP_ID_PROP_TB_GD_LEFT,          0);                              // TODO
    27: SendDpU16(GVL_GS_PROP_IDS.DP_ID_PROP_TC_GD_LEFT,          0);                              // TODO
    28: SendDpU16(GVL_GS_PROP_IDS.DP_ID_PROP_TA_GD_RIGHT,         0);                              // TODO
    29: SendDpU16(GVL_GS_PROP_IDS.DP_ID_PROP_TB_GD_RIGHT,         0);                              // TODO
    30: SendDpU16(GVL_GS_PROP_IDS.DP_ID_PROP_TC_GD_RIGHT,         0);                              // TODO
    31: SendDpU32(GVL_GS_PROP_IDS.DP_ID_PROP_POSITION_LIMIT_LOW,  0);                              // TODO
    32: SendDpU32(GVL_GS_PROP_IDS.DP_ID_PROP_POSITION_LIMIT_HIGH, 0);                              // TODO
    33: SendDpU32(GVL_GS_PROP_IDS.DP_ID_PROP_MAX_THRUST,          0);                              // TODO

END_CASE

nPropIndex := (nPropIndex + 1) MOD 34;
SendPropulsion := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="SendTelemetry" Id="{70ab0a90-ea43-4f72-be08-b70492b04a31}">
      <Declaration><![CDATA[METHOD PRIVATE SendTelemetry
VAR
	nTelemeteryIndex: INT := 0;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[
CASE nTelemeteryIndex OF
	0: SendLevitation();
	1: SendThermal();
	2: SendPropulsion();
	3: SendMisc();
	4: SendFlow();
END_CASE

nTelemeteryIndex := (nTelemeteryIndex + 1) MOD 5;]]></ST>
      </Implementation>
    </Method>
    <Method Name="SendThermal" Id="{80a8c1e2-37ed-4cc1-b543-748701fe96f2}">
      <Declaration><![CDATA[METHOD SendThermal : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[nSeqTx := nSeqTx + 1;
telemetry.counter := telemetry.counter + 1;
telemetry.timestamp_us := telemetry.timestamp_us + 10000; // placeholder while looking for method that gives system time

fbEncoder(
    msgId      := 16#0010,
    seqNum     := nSeqTx,
    pPayload   := ADR(telemetry),
    payloadLen := SIZEOF(telemetry)
);

fbSend(
    hSocket  := fbConnect.hSocket,
    cbLen    := fbEncoder.frameLen,
    pSrc     := ADR(fbEncoder.frame),
    bExecute := TRUE
);
bSendPending := TRUE;
SendTelemetry();]]></ST>
      </Implementation>
    </Method>
    <Method Name="TryParseFrames" Id="{ba047145-da3f-4ebc-b0ba-c4ab60c41fe4}">
      <Declaration><![CDATA[METHOD TryParseFrames : BOOL
VAR
    msgId, length : UINT;
    seqNum        : UDINT;
    total         : UINT;
    i             : UINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Loop because one read might contain multiple frames.
WHILE rxLen >= 8 DO
	msgId  := BYTE_TO_UINT(rxBuffer[0]) OR SHL(BYTE_TO_UINT(rxBuffer[1]), 8);
	length := BYTE_TO_UINT(rxBuffer[2]) OR SHL(BYTE_TO_UINT(rxBuffer[3]), 8);
	seqNum := BYTE_TO_UDINT(rxBuffer[4])
		   OR SHL(BYTE_TO_UDINT(rxBuffer[5]), 8)
		   OR SHL(BYTE_TO_UDINT(rxBuffer[6]), 16)
		   OR SHL(BYTE_TO_UDINT(rxBuffer[7]), 24);
	total := 8 + length;

	IF rxLen < total THEN
		EXIT;   // need more bytes
	END_IF

	// Dispatch on msgId.
	CASE msgId OF
		16#0020:    // MsgId::Command
			IF length = SIZEOF(lastCommand) THEN
				MEMCPY(ADR(lastCommand), ADR(rxBuffer[8]), length);
				bNewCommand := TRUE;
				nFramesReceived := nFramesReceived + 1;
			END_IF
		ELSE
			// Unknown msg_id — drop and resync by clearing the buffer.
			// (In future: log it.)
			rxLen := 0;
			EXIT;
	END_CASE

	// Slide the buffer down past the consumed frame.
	IF rxLen > total THEN
		MEMMOVE(ADR(rxBuffer[0]), ADR(rxBuffer[total]), rxLen - total);
	END_IF
	rxLen := rxLen - total;
END_WHILE
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>