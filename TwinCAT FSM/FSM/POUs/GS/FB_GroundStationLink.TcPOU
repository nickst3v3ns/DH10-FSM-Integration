<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_GroundStationLink" Id="{bb2708ad-2e30-4998-8a72-d284a9c1c89f}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_GroundStationLink
VAR_INPUT
    sRemoteHost     : STRING(15);
    nRemotePort     : UDINT := 6949;
    bEnable         : BOOL := TRUE;
END_VAR

VAR_OUTPUT
	bGsLinkAlive : BOOL;

    eState          : E_LinkState;
    bConnected      : BOOL;
    nFramesSent     : UDINT;
    nFramesReceived : UDINT;
    nReconnects     : UDINT;
    lastCommand     : ST_Command;
    bNewCommand     : BOOL;
END_VAR

VAR
	wdGsLink : TON;
	wdGsLinkTimeout : TIME := T#100MS;

	nUnknownMsgIds : UDINT;
	nHeartbeatsRx : UDINT;
	nLastMsgIdRx : UINT;	

	txBatch : ARRAY[0..2047] OF BYTE;
	txBatchLen : UDINT;
	dp1 : ST_DatapointFrame;
    fbConnect       : Tc2_TcpIp.FB_ClientServerConnection;
    fbSend          : Tc2_TcpIp.FB_SocketSend;
    fbReceive       : Tc2_TcpIp.FB_SocketReceive;
    fbEncoder       : FB_FrameEncoder;
    telemetry       : ST_PodTelemetry;
    sendTimer       : TON;
    sendInterval    : TIME := T#10MS;
    nSeqTx          : UDINT;
    bSendPending    : BOOL;
    rxBuffer        : ARRAY [0..1023] OF BYTE;
    rxLen           : UINT;
    rxScratch       : ARRAY [0..511] OF BYTE;
    rxScratchLen    : UDINT;
    reconnectTimer  : TON;
    reconnectDelay  : TIME := T#1S;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[CASE eState OF
    E_LinkState.eDisconnected:
        bConnected := FALSE;
        IF bEnable THEN
            fbConnect(
                sRemoteHost := sRemoteHost,
                nRemotePort := nRemotePort,
                bEnable := TRUE
            );
            eState := E_LinkState.eConnecting;
        END_IF

    E_LinkState.eConnecting:
        fbConnect(bEnable := TRUE, tReconnect := T#30S);
        IF fbConnect.bError THEN
            eState := E_LinkState.eReconnectWait;
            reconnectTimer(IN := FALSE);
        ELSIF fbConnect.eState = eSOCKET_CONNECTED THEN
            rxLen := 0;
            bConnected := TRUE;
            sendTimer(IN := FALSE);
			wdGsLink(IN := FALSE);
			bGsLinkAlive := TRUE;
            eState := E_LinkState.eConnected;
        END_IF

    E_LinkState.eConnected:
        sendTimer(IN := TRUE, PT := sendInterval);
        IF sendTimer.Q AND NOT bSendPending THEN
            sendTimer(IN := FALSE);
            SendPropulsion();
        END_IF

        IF bSendPending THEN
            fbSend(bExecute := TRUE);
            IF NOT fbSend.bBusy AND NOT fbSend.bError THEN
                fbSend(bExecute := FALSE);
                bSendPending := FALSE;
                nFramesSent := nFramesSent + 1;
            ELSIF fbSend.bError THEN
                fbSend(bExecute := FALSE);
                bSendPending := FALSE;
                eState := E_LinkState.eError;
            END_IF
        END_IF

        PollReceive();
		wdGsLink(IN := TRUE, PT := wdGsLinkTimeout);
		bGsLinkAlive := NOT wdGsLink.Q;

        IF fbConnect.eState <> eSOCKET_CONNECTED THEN
            eState := E_LinkState.eError;
        END_IF

    E_LinkState.eError:
        bConnected := FALSE;
        fbConnect(bEnable := FALSE);
        reconnectTimer(IN := FALSE);
        eState := E_LinkState.eReconnectWait;

    E_LinkState.eReconnectWait:
        reconnectTimer(IN := TRUE, PT := reconnectDelay);
        IF reconnectTimer.Q THEN
            reconnectTimer(IN := FALSE);
            nReconnects := nReconnects + 1;
            eState := E_LinkState.eDisconnected;
        END_IF

END_CASE]]></ST>
    </Implementation>
    <Method Name="AppendDatapoint" Id="{55febd3b-86f2-4a2c-94a0-27bbcb4a37ab}">
      <Declaration><![CDATA[METHOD AppendDatapoint : BOOL
VAR_INPUT
	id : UINT;
	valueBits : ULINT;
END_VAR
VAR
	ts : ULINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF(txBatchLen + 20) > SIZEOF(txBatch) THEN
	AppendDatapoint := FALSE;
	RETURN;
END_IF

ts := 0;
BuildDatapoint(id := id, valueBits := valueBits, timestampUs := ts, dp := dp1);
MEMCPY(ADR(txBatch[txBatchLen]), ADR(dp1), 20);
txBatchLen := txBatchLen + 20;
AppendDatapoint := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="AppendDP16" Id="{994ce20f-4c6e-4e04-a056-e10db23869a0}">
      <Declaration><![CDATA[METHOD AppendDP16 : BOOL
VAR_INPUT
	id : UINT;
	value : UINT;
END_VAR
VAR
	bits : ULINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[bits := 0;
MEMCPY(ADR(bits), ADR(value), 2);
AppendDatapoint(id := id, valueBits := bits);]]></ST>
      </Implementation>
    </Method>
