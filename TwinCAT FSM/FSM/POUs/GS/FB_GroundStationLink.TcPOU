    <Method Name="AppendDpU8" Id="{91e20036-b02c-4e61-8862-1a44c87ef13f}">
      <Declaration><![CDATA[METHOD AppendDpU8 : BOOL
VAR_INPUT
	id : UINT;
	value : BYTE;
END_VAR
VAR
	bits : ULINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[bits := 0;
