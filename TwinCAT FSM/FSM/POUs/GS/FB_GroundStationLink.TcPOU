<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_GroundStationLink" Id="{bb2708ad-2e30-4998-8a72-d284a9c1c89f}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_GroundStationLink
VAR_INPUT
    sRemoteHost     : STRING(15);
    nRemotePort     : UDINT := 6949;
    bEnable         : BOOL := TRUE;
END_VAR

VAR_OUTPUT
    eState          : E_LinkState;
    bConnected      : BOOL;
    nFramesSent     : UDINT;
    nFramesReceived : UDINT;
    nReconnects     : UDINT;
    lastCommand     : ST_Command;
    bNewCommand     : BOOL;
END_VAR

VAR
	dp1 : ST_DatapointFrame;
    fbConnect       : Tc2_TcpIp.FB_ClientServerConnection;
    fbSend          : Tc2_TcpIp.FB_SocketSend;
    fbReceive       : Tc2_TcpIp.FB_SocketReceive;
    fbEncoder       : FB_FrameEncoder;
    telemetry       : ST_PodTelemetry;
    sendTimer       : TON;
    sendInterval    : TIME := T#10MS;
    nSeqTx          : UDINT;
    bSendPending    : BOOL;
    rxBuffer        : ARRAY [0..1023] OF BYTE;
    rxLen           : UINT;
    rxScratch       : ARRAY [0..511] OF BYTE;
    rxScratchLen    : UDINT;
    reconnectTimer  : TON;
    reconnectDelay  : TIME := T#1S;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[CASE eState OF
    E_LinkState.eDisconnected:
        bConnected := FALSE;
        IF bEnable THEN
            fbConnect(
                sRemoteHost := sRemoteHost,
                nRemotePort := nRemotePort,
                bEnable := TRUE
            );
            eState := E_LinkState.eConnecting;
        END_IF

    E_LinkState.eConnecting:
        fbConnect(bEnable := TRUE, tReconnect := T#30S);
        IF fbConnect.bError THEN
            eState := E_LinkState.eReconnectWait;
            reconnectTimer(IN := FALSE);
        ELSIF fbConnect.eState = eSOCKET_CONNECTED THEN
            rxLen := 0;
            bConnected := TRUE;
            sendTimer(IN := FALSE);
            eState := E_LinkState.eConnected;
        END_IF

    E_LinkState.eConnected:
        sendTimer(IN := TRUE, PT := sendInterval);
        IF sendTimer.Q AND NOT bSendPending THEN
            sendTimer(IN := FALSE);
            SendOffset();
        END_IF

        IF bSendPending THEN
            fbSend(bExecute := TRUE);
            IF NOT fbSend.bBusy AND NOT fbSend.bError THEN
                fbSend(bExecute := FALSE);
                bSendPending := FALSE;
                nFramesSent := nFramesSent + 1;
            ELSIF fbSend.bError THEN
                fbSend(bExecute := FALSE);
                bSendPending := FALSE;
                eState := E_LinkState.eError;
            END_IF
        END_IF

        PollReceive();

        IF fbConnect.eState <> eSOCKET_CONNECTED THEN
            eState := E_LinkState.eError;
        END_IF

    E_LinkState.eError:
        bConnected := FALSE;
        fbConnect(bEnable := FALSE);
        reconnectTimer(IN := FALSE);
        eState := E_LinkState.eReconnectWait;

    E_LinkState.eReconnectWait:
        reconnectTimer(IN := TRUE, PT := reconnectDelay);
        IF reconnectTimer.Q THEN
            reconnectTimer(IN := FALSE);
            nReconnects := nReconnects + 1;
            eState := E_LinkState.eDisconnected;
        END_IF

END_CASE

IF bNewCommand THEN
    bNewCommand := FALSE;
END_IF]]></ST>
    </Implementation>
    <Method Name="BuildDatapoint" Id="{1984dfb5-e247-4430-8114-76733fe18619}">
      <Declaration><![CDATA[METHOD PRIVATE BuildDatapoint : BOOL
VAR_INPUT
    id          : UINT;
    valueBits   : ULINT;
    timestampUs : ULINT;
END_VAR
VAR_IN_OUT
    dp : ST_DatapointFrame;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[dp.sentinelStart := 16#FF;
dp.idBE[0]       := UINT_TO_BYTE(SHR(id, 8) AND 16#FF);   // high byte first (BE)
dp.idBE[1]       := UINT_TO_BYTE(id AND 16#FF);           // low byte
dp.value         := valueBits;
dp.timestampUs  := timestampUs;
dp.sentinelEnd   := 16#FF;
BuildDatapoint := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="PollReceive" Id="{62925d86-ab69-423e-bb6f-d19498152213}">
      <Declaration><![CDATA[METHOD PollReceive : BOOL
VAR
	bytesAvail : UDINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[fbReceive(
	hSocket  := fbConnect.hSocket,
	pDest    := ADR(rxScratch),
	cbLen    := SIZEOF(rxScratch),
	bExecute := TRUE
);
IF NOT fbReceive.bError AND NOT fbReceive.bError THEN
	fbReceive(bExecute := FALSE);
	IF fbReceive.nRecBytes > 0 THEN
		// Append to rxBuffer.
		IF (rxLen + fbReceive.nRecBytes) <= SIZEOF(rxBuffer) THEN
			MEMCPY(ADR(rxBuffer[rxLen]), ADR(rxScratch), fbReceive.nRecBytes);
			rxLen := UDINT_TO_UINT(rxLen + fbReceive.nRecBytes);
			TryParseFrames();
		ELSE
			// Buffer overflow — drop and resync. Treat as protocol error.
			rxLen := 0;
			eState := E_LinkState.eError;
		END_IF
	END_IF
ELSIF fbReceive.bError THEN
	fbReceive(bExecute := FALSE);
	eState := E_LinkState.eError;
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="SendDatapoint" Id="{1954acf1-0f13-4f0b-8601-03ebb95491bf}">
      <Declaration><![CDATA[METHOD SendDatapoint : BOOL
VAR_INPUT
	id : UINT;
	valueBits: ULINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[BuildDatapoint(
	id := id,
	valueBits := valueBits,
	timestampUs := 0,
	dp := dp1);
	
fbSend(
	hSocket := fbConnect.hSocket,
	cbLen := SIZEOF(dp1),
	pSrc := ADR(dp1),
	bExecute := TRUE);

bSendPending := TRUE;
nSeqTx := nSeqTx + 1;
SendDatapoint := TRUE;
	
	]]></ST>
      </Implementation>
    </Method>
    <Method Name="SendDpF32" Id="{8b58a37a-bfdd-4dd4-9552-479c5c73edf3}">
      <Declaration><![CDATA[METHOD SendDpF32 : BOOL
VAR_INPUT
	id : UINT;
	value : REAL;
END_VAR
VAR
	bits : ULINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[bits := 0;
MEMCPY(ADR(bits), ADR(value), 4);
SendDatapoint(id := id, valueBits := bits);]]></ST>
      </Implementation>
    </Method>
    <Method Name="SendDpF64" Id="{072a36ab-9a6d-4f83-80d5-343dda594ef5}">
      <Declaration><![CDATA[METHOD SendDpF64 : BOOL
VAR_INPUT
	id : UINT;
	value : LREAL;
END_VAR
VAR
	bits : ULINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[bits := 0;
MEMCPY(ADR(bits), ADR(value), 0);
SendDatapoint(id := id, valueBits := bits);
]]></ST>
      </Implementation>
    </Method>
