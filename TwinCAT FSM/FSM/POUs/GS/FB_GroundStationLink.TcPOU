      </Implementation>
    </Method>
    <Method Name="SendDpU8" Id="{91e20036-b02c-4e61-8862-1a44c87ef13f}">
      <Declaration><![CDATA[METHOD SendDpU8 : BOOL
VAR_INPUT
	id : UINT;
	value : BYTE;
END_VAR
VAR
	bits : ULINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[bits := 0;
MEMCPY(ADR(bits), ADR(value), 1);
SendDatapoint(id := id, valueBits := bits);]]></ST>
      </Implementation>
    </Method>
    <Method Name="SendFlow" Id="{81541abe-e6ef-4d15-ae44-5c575c029872}">
      <Declaration><![CDATA[METHOD SendFlow : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[nSeqTx := nSeqTx + 1;
telemetry.counter := telemetry.counter + 1;
telemetry.timestamp_us := telemetry.timestamp_us + 10000; // placeholder while looking for method that gives system time

fbEncoder(
    msgId      := 16#0010,
    seqNum     := nSeqTx,
    pPayload   := ADR(telemetry),
    payloadLen := SIZEOF(telemetry)
);

fbSend(
    hSocket  := fbConnect.hSocket,
    cbLen    := fbEncoder.frameLen,
    pSrc     := ADR(fbEncoder.frame),
    bExecute := TRUE
);
bSendPending := TRUE;
SendTelemetry();]]></ST>
      </Implementation>
    </Method>
