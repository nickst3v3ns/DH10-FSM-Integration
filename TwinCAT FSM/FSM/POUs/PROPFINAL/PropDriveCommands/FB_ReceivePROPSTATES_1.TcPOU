<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_ReceivePROPSTATES_1" Id="{05e7a3bf-1bc6-4480-b472-45eb5dc9167e}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_ReceivePROPSTATES_1
VAR_IN_OUT
	Inputs_1 : CANRXQUEUESTRUCT_E_32;
	Outputs_1 : CANTXQUEUESTRUCT_E_32;
END_VAR
VAR_OUTPUT
	PropState_1 : UINT;
END_VAR
VAR
	MessageReceived : ARRAY[0..31] OF EXTCANQUEUE;
	i : INT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[(*
IF Outputs.RxCounter <> Inputs.RxCounter THEN        // check if new data is in the buffer
   FOR i := 0 TO (Inputs.NoOfRxMessages-1) DO        // start the LOOP and check how much data
                                                     // is in the buffer
       	MessageReceived[i] := Inputs.RxMessages[i];   // copy the CAN message
   END_FOR
   Outputs.RxCounter := Inputs.RxCounter;            // set equal: the CAN interface then knows,
                                                     // that you have copied the CAN data
	FOR i := 0 TO (Inputs.NoOfRxMessages-1) DO        // start the LOOP and check how much data
                                                     // is in the buffer
	   IF MessageReceived[i].cobId = 100 THEN 
	       PropState := MessageReceived[i].data[0];
	   END_IF
   END_FOR
END_IF
*)

FOR i := 0 TO (Inputs_1.NoOfRxMessages-1) DO
    IF Inputs_1.RxMessages[i].cobId = 100 THEN 
        PropState_1 := Inputs_1.RxMessages[i].data[0];
    END_IF
END_FOR]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>