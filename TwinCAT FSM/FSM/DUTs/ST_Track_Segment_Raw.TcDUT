<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="ST_Track_Segment_Raw" Id="{2999b19f-7f35-48cb-b71e-6c5cb6a00b49}">
    <Declaration><![CDATA[TYPE ST_Track_Segment_Raw :			// all data extracted directly from EHW Center specification
STRUCT
	iTrackNumber: INT;				// track_number
	iXPosition: REAL;				// absolte start
	sType : WSTRING(8);				// type
	sBatch : WSTRING(1);			// batch
	iID : INT;						// barcode id
	iLength : REAL;					// length of section
	rStartValue : REAL;				// local start
	rEndValue : REAL;				// local end of barcode
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>