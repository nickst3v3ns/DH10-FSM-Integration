<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="ST_Command" Id="{adc3a6fe-5f6a-431f-9aed-7d88d0fc5b44}">
    <Declaration><![CDATA[TYPE ST_Command :
STRUCT
    // Mirrors the Rust Command struct.
    // Wire layout: value (4 bytes LE). Total payload size: 4 bytes.
    value : UDINT;    // u32, little-endian
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>