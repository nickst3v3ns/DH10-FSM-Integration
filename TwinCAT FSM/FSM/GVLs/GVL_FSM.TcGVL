<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <GVL Name="GVL_FSM" Id="{e9f32245-b0fa-4870-9fb8-012882e1d02d}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
VAR_GLOBAL
//Heartbeat + GS
	fbLink : FB_GroundStationLink := (
        sRemoteHost := '192.168.1.5',   // <-- ground station IP, change to match
        nRemotePort := 6949,
        bEnable     := TRUE
    );

	benable_heartbeat:				BOOL := FALSE; //for groundstation output
	bheartbeat_OK: 					BOOL := TRUE; //for groundstation evaluation
//Heartbeat + GS

//FSM Core variables	
	E_PodStateGlobal : E_PodState;
	E_CommandGlobal : E_Command;
	E_EmergencyReasonGlobal:			E_EmergencyReason := E_EmergencyReason.ERR_NONE;
//FSM Core variables

//TWINSAFE + BRAKES 
	bbrakes_arm_signalGlobal:				BOOL := FALSE; //Normally Closed system -> TRUE when retracted False when engaged
	bbrakes_clockGlobal:					BOOL := FALSE; //used for arming and dearming sequence
	bareBrakesEngaged:						BOOL := FALSE; //Normally Closed system -> TRUE when retracted False when engaged
	bbrakes_engageGlobal:					BOOL; //output for the regular relay system , replaced the clk + arm signal
	
	bsafety_inputs_valid:					BOOL := TRUE; //done through twinsafe PLC-TWINSAFE Run mode verification
	
	b_AlivePLCGlobal: 						BOOL := TRUE; //toggle to close or open the SDC via the SC enable relay
	bEstopOutGlobal:						BOOL; //this is the output of the TwinSAFE estop that verifies the state of the 

	bEstopErrorGlobal:						BOOL := FALSE; 
	bEstopRestartGlobal:					BOOL := FALSE; //Used to restart the Estop from the PLC side
	bFalseForEstopRestartGlobal:			BOOL := TRUE; //
	bSDCFeedbackGlobal:							BOOL; //feedback from twinSAFE for SDC state
	bJorianSpecialGlobal:					BOOL := TRUE; //not used
//TWINSAFE + BRAKES 

	
	
	benable_telemetryGlobal: 				BOOL; //may be deleted
	
//Ethercat + Comm Checks
	bcan_bus_ok: 					BOOL := TRUE; 
	nMasterDevStateCouplers AT %I*: UINT; 
	nMasterDevStatePLC AT %I*: 		UINT; 
	bethercat_ready:  				BOOL := TRUE; 
	bwatchdogResetGlobal:			BOOL;	
	
	RXwatchdogPropLeftGlobal:				BOOL;
	TXwatchdogPropLeftGlobal:				BOOL;
	
	RXwatchdogPropRightGlobal:				BOOL;
	TXwatchdogPropRightGlobal:				BOOL;
	
	RXwatchdogPTHVGlobal:							BOOL;
	TXwatchdogPTHVGlobal:							BOOL;
	
	LaserSensorWatchdogGlobal:						BOOL;
	
	bMovementSoftStopGlobal:						BOOL;
	
	
	//Critical Temperatures for Shutdown
	rcritical_temp_prop: 	REAL := 100.0; //maximum allowable temperature for propulsion. STILL A GUESS!!!!!
	rcritical_temp_HEMS: 	REAL := 40.0; //maximum allowable temperature for levitation HEMS
	rcritical_temp_EMS:		REAL := 60.0; //maximum allowable temperature for levitation EMS
	rcritical_temp_watercooling:	REAL;
	//rcritical_temp_PT:		REAL; //maximum allowable temperature for powertrain. commented out for now because PT should do this themselves
	
	
	//Temperatures to re enable after cooldown
	rcritical_temp_prop_coolDown: 	REAL := 95.0; //maximum allowable temperature for propulsion. STILL A GUESS!!!!!
	rcritical_temp_HEMS_coolDown: 	REAL := 35.0; //maximum allowable temperature for levitation HEMS
	rcritical_temp_EMS_coolDown:		REAL := 55.0; //maximum allowable temperature for levitation EMS
	rcritical_temp_watercooling_coolDown:	REAL;
	rcritical_temp_PT_coolDown:		REAL; //maximum allowable temperature for powertrain. commented out for now because PT should do this themselves
	
	Max_velocity_left : LREAL;
	Max_velocity_right : LREAL;
END_VAR]]></Declaration>
  </GVL>
</TcPlcObject>