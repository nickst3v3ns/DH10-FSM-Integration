<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <GVL Name="GVL_FSM" Id="{e9f32245-b0fa-4870-9fb8-012882e1d02d}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
VAR_GLOBAL
//Heartbeat
	fbLink : FB_GroundStationLink := (
        sRemoteHost := '192.168.1.9',   // <-- ground station IP, change to match
        nRemotePort := 6949,
        bEnable     := TRUE
    );

	benable_heartbeat:				BOOL := FALSE; //for groundstation output
	bheartbeat_OK: 					BOOL := TRUE; //for groundstation evaluation
	
	bprecharge:						BOOL := FALSE;
	
	E_PodStateGlobal : E_PodState;
	
	bsdc_closed:					BOOL := FALSE;
 
	bbrakes_armed:			BOOL := FALSE; //Normally Closed system -> TRUE when retracted False when engaged
	bbrakes_clock:			BOOL := FALSE; 
	bbrakes_engaged:			BOOL := FALSE; //Normally Closed system -> TRUE when retracted False when engaged
	

	
	bsafety_inputs_valid:			BOOL := FALSE; //done through twinsafe PLC-TWINSAFE Run mode verification
	
	b_AlivePLC AT %Q*: 				BOOL := TRUE; //NC System

	bEstopError:					BOOL := FALSE; 
	bEstopRestart:					BOOL := FALSE; //Used to restart the Estop from the PLC side
	bFalseForEstopRestart:			BOOL := FALSE;
	
	benable_telemetry: 				BOOL;
	
	bcan_bus_ok: 					BOOL := TRUE; 
	nMasterDevStateCouplers AT %I*: UINT; 
	nMasterDevStatePLC AT %I*: 		UINT; 
	bethercat_ready:  				BOOL := TRUE; 
	
	
	
	//Critical Temperatures for Shutdown
	rcritical_temp_prop: 	REAL := 100.0; //maximum allowable temperature for propulsion. STILL A GUESS!!!!!
	rcritical_temp_HEMS: 	REAL := 40.0; //maximum allowable temperature for levitation HEMS
	rcritical_temp_EMS:		REAL := 60.0; //maximum allowable temperature for levitation EMS
	rcritical_temp_watercooling:	REAL;
	//rcritical_temp_PT:		REAL; //maximum allowable temperature for powertrain. commented out for now because PT should do this themselves
	
	
	//Temperatures to re enable after cooldown
	rcritical_temp_prop_coolDown: 	REAL := 95.0; //maximum allowable temperature for propulsion. STILL A GUESS!!!!!
	rcritical_temp_HEMS_coolDown: 	REAL := 35.0; //maximum allowable temperature for levitation HEMS
	rcritical_temp_EMS_coolDown:		REAL := 55.0; //maximum allowable temperature for levitation EMS
	rcritical_temp_watercooling_coolDown:	REAL;
	rcritical_temp_PT_coolDown:		REAL; //maximum allowable temperature for powertrain. commented out for now because PT should do this themselves
	

END_VAR]]></Declaration>
  </GVL>
</TcPlcObject>