  <GVL Name="GVL_Prop" Id="{50abe306-50cd-40fe-9fcd-ded7060b0d4e}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
VAR_GLOBAL
	//First propulsion checks
	enable_prop_checks: 	BOOL;
	
	speed:					REAL;
	target_speed:			REAL;
	
	accelerating:			BOOL;
	braking:				BOOL;
	
	propulsion_fault: 		BOOL;
	propulsion_enable: 		BOOL;
	propulsion_active: 		BOOL;
	
	//DC-Link voltages
	drive_voltages1 AT %I*:	REAL;
	drive_voltages2 AT %I*:	REAL;
	drive_voltages3 AT %I*:	REAL;
	drive_voltages4 AT %I*:	REAL;
END_VAR]]></Declaration>
  </GVL>
