<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <GVL Name="GVL_Prop" Id="{50abe306-50cd-40fe-9fcd-ded7060b0d4e}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
VAR_GLOBAL
	//First propulsion checks
	
	//barcode 
	
	OutputData_Front AT %Q*: ARRAY[0..7] OF BYTE;
	OutputData_Back AT %Q*: ARRAY[0..7] OF BYTE;
	
	InputData1_Front AT %I*: ARRAY[0..7] OF BYTE;
	InputData2_Front AT %I*: ARRAY[0..7] OF BYTE;
	InputData3_Front AT %I*: ARRAY[0..7] OF BYTE;
	
	InputData1_Back AT %I*: ARRAY[0..7] OF BYTE;
	InputData2_Back AT %I*: ARRAY[0..7] OF BYTE;
	InputData3_Back AT %I*: ARRAY[0..7] OF BYTE;
	
	//drives
	
	enable_prop_checks: 	BOOL;
	
	speed:					REAL;
	target_speed:			REAL;
	
	accelerating:			BOOL;
	braking:				BOOL;
	
	propulsion_fault: 		BOOL := FALSE;
	propulsion_enable: 		BOOL;
	propulsion_active: 		BOOL;
	
	//DC-Link voltages
	drive_voltages1 AT %I*:	REAL := 0;
	drive_voltages2 AT %I*:	REAL := 0;
	drive_voltages3 AT %I*:	REAL := 0;
	drive_voltages4 AT %I*:	REAL := 0;
	
	DC_LINK_SAFE			:BOOL;
END_VAR]]></Declaration>
  </GVL>
</TcPlcObject>