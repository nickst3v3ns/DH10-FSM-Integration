  <GVL Name="GVL_THERMAL" Id="{dfd323d1-9596-473d-978f-734bbaaa8d3e}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
VAR_GLOBAL
	
	//VFL1, VFL2, VFR1, VFR2, VBL1, VBL2, VBR1, VBR2
	T_EMS:		ARRAY[0..7] OF REAL;
	
	
	//VFL1, VFL2, VFR1, VFR2, VBL1, VBL2, VBR1, VBR2
	T_HEMS:		ARRAY[0..7] OF REAL;
	
	
	
	T_MOTOR_LEFTBACK:	ARRAY[0..8] OF REAL;
	T_MOTOR_RIGHTBACK:	ARRAY[0..8] OF REAL;
	T_MOTOR_LEFTFRONT:	ARRAY[0..8] OF REAL;
	T_MOTOR_RIGHTFRONT:	ARRAY[0..8] OF REAL;
	
	
	T_FLOW:		ARRAY[0..7] OF REAL;


//OVERHEAT bools
	bHEMSOVERHEAT			:BOOL;
	bEMSOVERHEAT			:BOOL;
	bMOTOROVERHEAT			:BOOL;
	bFLOWOVERHEAT			:BOOL;
	
	
//PWM CONTROL
	fDutyCycle_PROP			:REAL := 0;
	fDutyCycle_LEVI			:REAL := 0;
END_VAR

