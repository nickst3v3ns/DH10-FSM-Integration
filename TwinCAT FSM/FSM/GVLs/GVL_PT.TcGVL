  <GVL Name="GVL_PT" Id="{c13a7a8c-c8d8-41ce-a220-df2a506caa64}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
VAR_GLOBAL
	//PTC STATUS
	HVAL_STATUS:			USINT; //Status for the High Voltage Active Light / Not sure if the PLC needs this
	ERROR_STATUS: 			USINT; //Error status from the Powertrain Controller
	PTC_STATE:				USINT;
	IMD_WARNINGS:			USINT;
	FAIL_REASON:			USINT;
	
	//HV STATUS
	ISO_RES:				UINT; //Isolation resistance IMD
	IVT_CURRENT:			DWORD; //Isabellehutte current
	
	//BMS_LOG_A : from the BMS
	MAX_VOLTAGE:			UINT;
	MIN_VOLTAGE:			UINT;
	MAX_TEMP: 				UINT; //Maximum temperature measured by BMS  
	MIN_TEMP:				UINT;
	
	//BMS_LOG_B : from the BMS but total?
	TOTAL_VOLTAGE:			UINT;
	PACK_CURRENT:			UINT;
	DC_LINK_VOLTAGE:		DWORD;
	
	emergency_shutdown:		BOOL; //might need to be reworked
	
END_VAR


