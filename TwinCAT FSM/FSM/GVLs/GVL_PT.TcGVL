	MIN_VOLTAGE : UINT;
	MAX_TEMP : UINT;
	MIN_TEMP : UINT;
	
	//BMS_LOG_B
	TOTAL_VOLTAGE : UINT;
	PACK_CURRENT : UINT;
	DC_LINK_VOLTAGE : DWORD;
	
	emergency_shutdown:		BOOL; //might need to be reworked
	
	
//LVBAT
	CAN_NODE_STATE_LV AT %I*:		USINT;
END_VAR

