<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <GVL Name="GVL_LEVI" Id="{d4dca03b-650a-425c-b19f-85a72034f677}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
VAR_GLOBAL
	
	levitation_enable 				: BOOL;
	levitation_fault 				: BOOL; //fatal levitation error
	Levi_command 					: E_Levi_States; //Levi_command is where you tell the pod to which levi state you want to switch. The code will then check if you are allowed to switch to that state.
	levitation_state 				: E_Levi_States;
	reset_targets					: BOOL;
	enable_auto_z_target 			: BOOL := TRUE;
	enable_auto_y_target 			: BOOL := TRUE;
	enable_auto_yaw_target 			: BOOL := TRUE;
	
	//----------------------------------------------------------------------------------------------------

	//	Variables for the groundstation

	//----------------------------------------------------------------------------------------------------
	
	//DC link voltages
	DC_link_voltage_HEMS 			: ARRAY[0..15] OF UINT;
	DC_link_voltage_EMS 			: ARRAY[0..7] OF UINT;
	
	//Levi currents
	HEMS_real_current 				: ARRAY[0..15] OF LREAL;
	HEMS_requested_current 			: ARRAY[0..7] OF LREAL;
	EMS_real_current 				: ARRAY[0..7] OF LREAL;
	EMS_requested_current 			: ARRAY[0..3] OF LREAL;
	
	//Levi power usage
	Power_usage_HEMS 				: LREAL;
	Power_usage_EMS 				: LREAL;
	Power_usage_Levi 				: LREAL;

	DC_LINK_SAFE 					: BOOL;
	
	Drive_status 					: ARRAY[0..23] OF UINT;
	Drive_Diagnostic 				: ARRAY[0..23] OF UINT;
	Periphery_voltage 				: ARRAY[0..23] OF UINT;
	Control_word 					: ARRAY[0..23] OF UINT;
	All_drives_high_voltage			: BOOL;
	
	reset_busy 						: BOOL;
	reset_error 					: BOOL;
	n_drive_warnings 				: UINT;
	n_drive_errors 					: UINT;
	error_specifics 				: ARRAY[0..23] OF Drive_error_mapping;
	drive_feedback_timeouts 		: ARRAY[0..23] OF UINT;
	Drive_current_error 			: ARRAY[0..23] OF BOOL;
	Error 							: BOOL;
	error_resettable 				: BOOL;
	error_emergency 				: BOOL;
	error_non_emergency 			: BOOL;
	
	Levi_ready 						: BOOL;
	
	z								: LREAL; //m
	roll							: LREAL; //rad
	pitch							: LREAL; //rad
	
	y								: LREAL; //m
	yaw								: LREAL;	//rad
	
	z_liftoff 						: LREAL; //m
	
	z_target 						: LREAL; //m
	pitch_target 					: LREAL; //rad
	roll_target 					: LREAL; //rad
	y_target 						: LREAL; //m
	yaw_target 						: LREAL; //rad
	
	SensorDataArray 				: ARRAY[0..11] OF REAL;
	Offset_airgaps_vertical 		: ARRAY[0..5] OF LREAL;
	Offset_airgaps_lateral 			: ARRAY[0..5] OF LREAL;
	
	liftoff_in_progress 			: BOOL;
	descent_in_progress 			: BOOL;
	auto_DOF_states 				: E_auto_DOF_states;
	found_auto_z_target 			: BOOL;
	found_auto_y_target 			: BOOL;
	found_auto_yaw_target 			: BOOL;
	normal_shutdown 				: BOOL;
	
	//----------------------------------------------------------------------------------------------------

	//	Variables for the laser sensor code

	//----------------------------------------------------------------------------------------------------

	
	
	//FOR laser Sensors
	RxBufferEL				: ComBuffer;	(* Receive data buffer; used with all receive function blocks *) 
	TxBufferEL				: ComBuffer;	(* Transmit data buffer; used with all receive function blocks *)
	
	//Vertical right
	RxBufferEL_VFR			: ComBuffer;	(* Receive data buffer; used with all receive function blocks *)
	TxBufferEL_VFR			: ComBuffer;	(* Transmit data buffer; used with all receive function blocks *)
	RxBufferEL_VMR			: ComBuffer;	(* Receive data buffer; used with all receive function blocks *)
	TxBufferEL_VMR			: ComBuffer;	(* Transmit data buffer; used with all receive function blocks *)
	RxBufferEL_VBR			: ComBuffer;	(* Receive data buffer; used with all receive function blocks *)
	TxBufferEL_VBR			: ComBuffer;	(* Transmit data buffer; used with all receive function blocks *)
	
	//vertical left
	RxBufferEL_VFL			: ComBuffer;	(* Receive data buffer; used with all receive function blocks *)
	TxBufferEL_VFL			: ComBuffer;	(* Transmit data buffer; used with all receive function blocks *)
	RxBufferEL_VML			: ComBuffer;	(* Receive data buffer; used with all receive function blocks *)
	TxBufferEL_VML			: ComBuffer;	(* Transmit data buffer; used with all receive function blocks *)
	RxBufferEL_VBL			: ComBuffer;	(* Receive data buffer; used with all receive function blocks *)
	TxBufferEL_VBL			: ComBuffer;	(* Transmit data buffer; used with all receive function blocks *)
	
	//Lateral left
	RxBufferEL_LFL			: ComBuffer;	(* Receive data buffer; used with all receive function blocks *)
	TxBufferEL_LFL			: ComBuffer;	(* Transmit data buffer; used with all receive function blocks *)
	RxBufferEL_LML			: ComBuffer;	(* Receive data buffer; used with all receive function blocks *)
	TxBufferEL_LML			: ComBuffer;	(* Transmit data buffer; used with all receive function blocks *)
	RxBufferEL_LBL			: ComBuffer;	(* Receive data buffer; used with all receive function blocks *)
	TxBufferEL_LBL			: ComBuffer;	(* Transmit data buffer; used with all receive function blocks *)
	
	//lateral right
	RxBufferEL_LFR			: ComBuffer;	(* Receive data buffer; used with all receive function blocks *)
	TxBufferEL_LFR			: ComBuffer;	(* Transmit data buffer; used with all receive function blocks *)
	RxBufferEL_LMR			: ComBuffer;	(* Receive data buffer; used with all receive function blocks *)
	TxBufferEL_LMR			: ComBuffer;	(* Transmit data buffer; used with all receive function blocks *)
	RxBufferEL_LBR			: ComBuffer;	(* Receive data buffer; used with all receive function blocks *)
	TxBufferEL_LBR			: ComBuffer;	(* Transmit data buffer; used with all receive function blocks *)
	
	(* 	I/O variables for a EL6021 terminal*)
	stIn_EL6021_VFR AT %I*	: EL6inData22B;	(* linked to the EL6021 in the TwinCAT System Manager : TO LaSeVerticalLeftFront*)
	stOut_EL6021_VFR AT %Q*	: EL6outData22B;(* linked to the EL6021 in the TwinCAT System Manager : TO LaSeVerticalLeftFront*)
	stIn_EL6021_VMR AT %I*	: EL6inData22B;	(* linked to the EL6021 in the TwinCAT System Manager : TO LaSeVerticalLeftMiddle*)
	stOut_EL6021_VMR AT %Q*	: EL6outData22B;(* linked to the EL6021 in the TwinCAT System Manager : TO LaSeVerticalLeftMiddle*)
	stIn_EL6021_VBR AT %I*	: EL6inData22B;	(* linked to the EL6021 in the TwinCAT System Manager : TO LaSeVerticalLeftBack*)
	stOut_EL6021_VBR AT %Q*	: EL6outData22B;(* linked to the EL6021 in the TwinCAT System Manager : TO LaSeVerticalLeftBack*)
	
	stIn_EL6021_VFL AT %I*	: EL6inData22B;	(* linked to the EL6021 in the TwinCAT System Manager : TO LaSeVerticalRightBack*)
	stOut_EL6021_VFL AT %Q*	: EL6outData22B;(* linked to the EL6021 in the TwinCAT System Manager : TO LaSeVerticalRightBack*)
