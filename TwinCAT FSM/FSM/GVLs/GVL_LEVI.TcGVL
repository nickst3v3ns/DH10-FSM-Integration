	K_D_yaw: LREAL := 5000;
	K_F_yaw: LREAL := 120;
	K_I_yaw_initial: LREAL := 39;	
	
	auto_z_target_gain : LREAL := 0.00025;
	auto_y_target_gain : LREAL := 0.00050;
	auto_yaw_target_gain : LREAL := 0.00025;
	
	auto_y_target_I_gain : LREAL := 1;
	auto_yaw_target_I_gain : LREAL := 1;
	
	extreme_z_gain_multiplier : LREAL := 1;
	extreme_pitch_gain_multiplier : LREAL := 1;
	extreme_roll_gain_multiplier : LREAL := 1;
	extreme_y_gain_multiplier : LREAL := 1;
	extreme_yaw_gain_multiplier : LREAL := 1;
	
	thermal_gap_gain_derivative_multiplier : LREAL := 1;
	
	thermal_gap_gain_hems : LREAL := 1.16;
	thermal_gap_gain_ems : LREAL := 1.16;
	
	motor_roll_gain : LREAL := 1;
	motor_y_gain : LREAL := 1;
	motor_yaw_gain : LREAL := 1;	
	
	FF_Delay : REAL;
	position_tune : REAL;
	
	Lift_off_enabled : BOOL := TRUE;
	descent_enabled : BOOL := TRUE;
	Mismatch_enabled : BOOL := FALSE;
	
	feed_fwd_on_prop_roll : BOOL := FALSE;
	feed_fwd_motor_y_on : BOOL := FALSE;
	feed_fwd_motor_yaw_on : BOOL := FALSE;
	feed_fwd_ON_ems : BOOL := TRUE;
