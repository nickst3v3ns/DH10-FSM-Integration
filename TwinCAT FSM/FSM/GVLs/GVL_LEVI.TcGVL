	stOut_EL6021_VML AT %Q*	: EL6outData22B;(* linked to the EL6021 in the TwinCAT System Manager : TO LaSeVerticalRightMiddle*)
	stIn_EL6021_VBL AT %I*	: EL6inData22B;	(* linked to the EL6021 in the TwinCAT System Manager : TO LaSeVerticalRightFront*)
	stOut_EL6021_VBL AT %Q*	: EL6outData22B;(* linked to the EL6021 in the TwinCAT System Manager : TO LaSeVerticalRightFront*)
	
	//Lateral
	stIn_EL6021_LFL AT %I*	: EL6inData22B;	(* linked to the EL6021 in the TwinCAT System Manager : TO LaSeHorizontalRightBack*)
	stOut_EL6021_LFL AT %Q*	: EL6outData22B;(* linked to the EL6021 in the TwinCAT System Manager : TO LaSeHorizontalRightBack*)
	stIn_EL6021_LML AT %I*	: EL6inData22B;	(* linked to the EL6021 in the TwinCAT System Manager : TO LaSeHorizontalRightMiddle*)
	stOut_EL6021_LML AT %Q*	: EL6outData22B;(* linked to the EL6021 in the TwinCAT System Manager : TO LaSeHorizontalRightMiddle*)
	stIn_EL6021_LBL AT %I*	: EL6inData22B;	(* linked to the EL6021 in the TwinCAT System Manager : TO LaSeHorizontalRightFront*)
	stOut_EL6021_LBL AT %Q*	: EL6outData22B;(* linked to the EL6021 in the TwinCAT System Manager : TO LaSeHorizontalRightFront*)
	
	stIn_EL6021_LFR AT %I*	: EL6inData22B;	(* linked to the EL6021 in the TwinCAT System Manager : TO LaSeHorizontalLeftFront*)
	stOut_EL6021_LFR AT %Q*	: EL6outData22B;(* linked to the EL6021 in the TwinCAT System Manager : TO LaSeHorizontalLeftFront*)
	stIn_EL6021_LMR AT %I*	: EL6inData22B;	(* linked to the EL6021 in the TwinCAT System Manager : TO LaSeHorizontalLeftMiddle*)
	stOut_EL6021_LMR AT %Q*	: EL6outData22B;(* linked to the EL6021 in the TwinCAT System Manager : TO LaSeHorizontalLeftMiddle*)
	stIn_EL6021_LBR AT %I*	: EL6inData22B;	(* linked to the EL6021 in the TwinCAT System Manager : TO LaSeHorizontalLeftBack*)
	stOut_EL6021_LBR AT %Q*	: EL6outData22B;(* linked to the EL6021 in the TwinCAT System Manager : TO LaSeHorizontalLeftBack*)
	
	//----------------------------------------------------------------------------------------------------

	//	Control parameters

	//----------------------------------------------------------------------------------------------------
	
	Levi_operational : BOOL := TRUE;
	
	Vertical_on : BOOL := TRUE;
	Lateral_on : BOOL := TRUE;
	Motor_on : BOOL := TRUE;
	
	Total_on : BOOL := TRUE;
	Pitch_on : BOOL := TRUE;
	Roll_on : BOOL := TRUE;
	y_on : BOOL := TRUE;
	yaw_on : BOOL := TRUE;	
	
